{
  "$schema": "https://raw.githubusercontent.com/nicedoc/tauri/refs/heads/dev/crates/tauri-config-schema/schema.json",
  "productName": "DataGen",
  "identifier": "com.datagen.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "DataGen",
        "width": 1200,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "dmg", "nsis"],
    "publisher": "Cynosure <72688232+cynosure279@users.noreply.github.com>",
    "shortDescription": "ACM test data generator and judge tool",
    "longDescription": "DataGen generates test data for ACM contest problems and runs a judge to evaluate solutions against them.",
    "license": "Apache-2.0",
    "licenseFile": "../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": ["gcc", "g++", "python3"],
        "section": "utils",
        "priority": "optional",
        "files": {
          "/usr/share/doc/data-gen/copyright": "../debian/copyright",
          "/usr/share/lintian/overrides/data-gen": "../debian/data-gen.lintian-overrides"
        }
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
